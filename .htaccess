# ====================================================================
#  AquaGleam Car Wash & Detailing - Production Server Hardening
#  Windows Mini-PC Local Web Server Security Rules
# ====================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes -MultiViews

# 2. Block Hidden Files & Dotfiles (.git, .env, .htaccess, etc.)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Block Direct Web Access to Sensitive File Formats
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|md|bat|sh|jsonl|ini|yml|yaml|env)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|log|md|bat|sh|jsonl|ini|yml|yaml|env)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 4. Block Direct Web Execution of Automated Test Files
<IfModule mod_authz_core.c>
    <FilesMatch "^test_.*\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^test_.*\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 5. Block Direct Web Access to Demo Accounts File
<IfModule mod_authz_core.c>
    <FilesMatch "^demo_accounts.*\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^demo_accounts.*\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 6. Block Access to Internal Folders and Hidden Directories (.git, graphify-out, etc.)
# Web should only directly access: index.php, tv.php, public/, and api/
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block any path component starting with a dot (.git, .env, .cache, etc.)
    RewriteRule (^|/)\. - [F,L,NC]

    # Block internal folders and analysis artifacts
    RewriteRule ^(config|core|database|storage|tests|docs|bin|scripts|graphify-out)/ - [F,L,NC]
</IfModule>

# Fallback directory protection (when mod_rewrite is disabled)
RedirectMatch 403 (^|/)\.
RedirectMatch 403 ^/(config|core|database|storage|tests|docs|bin|scripts|graphify-out)(/.*)?$


# 6. Security Headers (Safe Cookies, Clickjacking, MIME, CSP)
<IfModule mod_headers.c>
    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Block Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy (Enforce 100% self-contained local assets - no third-party CDNs)
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' data:; connect-src 'self' http://127.0.0.1:1818; font-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
</IfModule>
